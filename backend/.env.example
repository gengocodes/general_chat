GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
FRONTEND_ORIGIN=http://localhost:3000
BUCKET_MANAGER_URL=http://bucket-manager:8001
DOCUMENT_PROCESSOR_URL=http://document-processor:8002
INTERNAL_API_KEY=your_internal_service_secret_here

# PostgreSQL (Neon). Docker Compose overrides both with the bundled local postgres:18.
# DATABASE_URL: pooled connection (host contains -pooler) used by the app at runtime.
# DATABASE_MIGRATION_URL: direct (non-pooler) connection used only by Alembic.
# Both must use the postgresql+psycopg:// scheme and sslmode=require for Neon.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Google Sign-In (must equal NEXT_PUBLIC_GOOGLE_CLIENT_ID in frontend/.env)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Session tokens: at least 32 random characters (openssl rand -hex 32)
JWT_SECRET=replace_with_openssl_rand_hex_32_output
SESSION_LIFETIME_DAYS=7
FREE_MESSAGE_LIMIT=2
# Keep true in production; Docker Compose sets false for local HTTP development.
COOKIE_SECURE=true

AUTH_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10
DOWNLOAD_RATE_LIMIT_PER_MINUTE=30

INTERNAL_IAM_AUTH_ENABLED=false
