# Backend API endpoint URL (proxied through Next.js /api/:path* rewrites for first-party cookies)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of origins/domains allowed to embed this frontend in an <iframe>.
# Leave empty to block all external websites from framing the app ('self' only).
# Example: ALLOWED_DOMAINS=https://example.com,https://*.example.com
ALLOWED_DOMAINS=

# Google OAuth Web Client ID (must match GOOGLE_CLIENT_ID in backend/.env)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
